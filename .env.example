# ── ClickHouse Cloud ──────────────────────────────────────────────────────────
# Get these from your ClickHouse Cloud console at clickhouse.cloud
CLICKHOUSE_URL=jdbc:ch://your-instance.clickhouse.cloud:8443/cinemetrics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_DB=cinemetrics

# ── Google Cloud / Gemini ─────────────────────────────────────────────────────
# Your GCP project ID (find it in Cloud Console)
GCP_PROJECT_ID=your-gcp-project-id
# Region — us-central1 has best Gemini availability
GCP_LOCATION=us-central1

# ── OMDB API (optional — only needed for real ingestion) ─────────────────────
# Free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key

# ── Dev settings ──────────────────────────────────────────────────────────────
# Set to true to seed 10 demo films on startup (local dev / demo)
SEED_ON_STARTUP=true

# CORS — add your Node.js frontend URL here
CORS_ORIGINS=http://localhost:3000
